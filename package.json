{
  "name": "ai-sre",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "bun scripts/readable.ts && bun scripts/plain-english.ts && bun install --frozen-lockfile && bun scripts/check.ts && bun scripts/verify.ts --all && bun test && bun run text-audit",
    "text-audit": "AUDIT_URL=http://localhost:8000 AUDIT_SERVER=\"bash $PWD/e2e/serve.sh\" playwright test -c e2e/playwright.config.ts --trace off",
    "readable": "bun scripts/readable.ts",
    "plain-english": "bun scripts/plain-english.ts",
    "format": "biome check --write .",
    "verify": "bun scripts/verify.ts",
    "world": "bun scripts/world.ts",
    "demo": "bun agent/demo.ts",
    "approve": "bun scripts/approve.ts",
    "models": "bun scripts/models.ts",
    "record": "bun scripts/record.ts",
    "shots": "bun scripts/shots.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.103",
    "@ai-sdk/mcp": "2.0.98",
    "@ai-sdk/openai": "4.0.116",
    "@ai-sdk/provider": "4.0.38",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "ai": "7.0.171",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "chdb": "3.5.0",
    "playwright": "1.65.0"
  }
}
