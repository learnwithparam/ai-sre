# Copy nothing by hand: `bun run world` creates .env from this file and fills every generated value.
# This file lists every key the course reads. It holds no values.

# Models. replay needs no key and is the default; set one provider and its key to use a live model.
LLM_PROVIDER=replay
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Generated by bun run world
HYPERDX_API_KEY=
HYPERDX_ACCESS_KEY=
HYPERDX_USER_EMAIL=
HYPERDX_USER_PASSWORD=
CLICKHOUSE_READER_PASSWORD=
CLICKHOUSE_WRITER_PASSWORD=
POSTGRES_PASSWORD=
SRE_MCP_TOKEN=
SRE_SESSION_SECRET=
SRE_APPROVER_EMAIL=
SRE_APPROVER_PASSWORD=
WORLD_DIR=
